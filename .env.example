# =============================================================
# pipPing environment configuration
# Copy this file to ".env" and fill in your real values.
# This file is safe to commit; never commit the real ".env".
# =============================================================

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Default Telegram chat id (your numerical id from @userinfobot, or @channel_handle).
# Used when an alert does not specify its own chat id. (required)
TELEGRAM_CHAT_ID=

# Twelve Data API key for forex / gold prices: https://twelvedata.com
TWELVE_DATA_API_KEY=

# HTTP server port (default 8080)
PORT=8080

# -----------------------------------------------------------------
# Crypto polling (Binance is free).
# -----------------------------------------------------------------
POLL_INTERVAL_CRYPTO_MS=60000

# -----------------------------------------------------------------
# Twelve Data REST fallback (only used for symbols rejected by the
# WebSocket on the free plan).
# -----------------------------------------------------------------
POLL_INTERVAL_TD_FALLBACK_MS=300000

# =============================================================
# Firebase (client) — public web config, ships in the JS bundle.
# Find these in the Firebase Console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup
# =============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# =============================================================
# Firebase Admin (server) — secret, never bundled to the client.
# Easiest: in Firebase Console -> Project settings -> Service accounts
#   -> "Generate new private key" -> download the JSON file
#   -> paste the entire contents as a single line below.
# Alternative: set GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# =============================================================
FIREBASE_SERVICE_ACCOUNT_JSON=

# =============================================================
# Single-user access control
#
# The one and only email allowed to sign in and use the API.
# Both vars must be set to the same value. The server value
# (ALLOWED_EMAIL) is the real gate; the client value
# (VITE_ALLOWED_EMAIL) only controls the sign-in form.
# Both will be blank if you forget to set them — the client
# shows a "configuration needed" screen and the server rejects
# every API call with 403.
# =============================================================
VITE_ALLOWED_EMAIL=
ALLOWED_EMAIL=
