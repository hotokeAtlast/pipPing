# =============================================================
# pipPing environment configuration
# Copy this file to ".env" and fill in your real values.
# =============================================================

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Default Telegram chat id (your numerical id from @userinfobot, or @channel_handle).
# Used when an alert does not specify its own chat id. (required)
TELEGRAM_CHAT_ID=

# Twelve Data API key for forex / gold prices: https://twelvedata.com
# Free tier: 800 credits/day, 8 calls/min, each symbol = 1 credit per call.
TWELVE_DATA_API_KEY=

# HTTP server port (default 8080)
PORT=8080

# -----------------------------------------------------------------
# Poll intervals (in ms). Two separate intervals so we don't burn
# Twelve Data credits on crypto.
# -----------------------------------------------------------------

# Binance (crypto) is free, poll fast. 60s gives you alerts within a
# minute of the price crossing your threshold.
POLL_INTERVAL_CRYPTO_MS=60000

# Twelve Data (forex/gold) is credit-limited.
# 4 symbols * 144 polls/day at 10-min interval = 576 credits/day
# (28% headroom under the 800/day limit).
POLL_INTERVAL_TD_MS=600000
