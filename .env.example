# =============================================================
# pipPing environment configuration
# Copy this file to ".env" and fill in your real values.
# =============================================================

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Default Telegram chat id (your numerical id from @userinfobot, or @channel_handle).
# Used when an alert does not specify its own chat id. (required)
TELEGRAM_CHAT_ID=

# Twelve Data API key for forex / commodity / index prices: https://twelvedata.com
# Free tier: 800 credits/day, 8 calls/min, each symbol = 1 credit per call.
TWELVE_DATA_API_KEY=

# HTTP server port (default 8080)
PORT=8080

# -----------------------------------------------------------------
# Poll intervals (in ms). Two separate intervals so we don't burn
# Twelve Data credits on crypto.
# -----------------------------------------------------------------

# Binance (crypto) is free, poll fast.
POLL_INTERVAL_CRYPTO_MS=120000

# Twelve Data (forex/commodity/index) is credit-limited.
# 9 symbols * 96 polls/day at 15-min interval = 864 credits/day
# (just over the 800/day limit). Bump to 1200000 (20 min) if you
# hit "credit limit reached" warnings.
POLL_INTERVAL_TD_MS=900000
