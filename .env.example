# =============================================================
# pipPing environment configuration
# Copy this file to ".env" and fill in your real values.
# =============================================================

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Default Telegram chat id (your numerical id from @userinfobot, or @channel_handle).
# Used when an alert does not specify its own chat id. (required)
TELEGRAM_CHAT_ID=

# Twelve Data API key for forex / gold prices: https://twelvedata.com
# Basic (free) plan WebSocket: 8 simultaneous symbol slots, BUT only a
# subset of symbols are accepted on the free tier. The engine handles
# this automatically: accepted symbols stream live (~1s), gated symbols
# fall back to REST polling at POLL_INTERVAL_TD_FALLBACK_MS below.
TWELVE_DATA_API_KEY=

# HTTP server port (default 8080)
PORT=8080

# -----------------------------------------------------------------
# Crypto polling (Binance is free).
# -----------------------------------------------------------------
POLL_INTERVAL_CRYPTO_MS=60000

# -----------------------------------------------------------------
# Twelve Data REST fallback (only used for symbols rejected by the
# WebSocket on the free plan).
# Free tier = 800 credits/day, each symbol per call = 1 credit.
# 2 gated symbols * 288 polls/day at 5-min interval = 576 credits/day.
# -----------------------------------------------------------------
POLL_INTERVAL_TD_FALLBACK_MS=300000
