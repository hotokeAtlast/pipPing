# =============================================================
# pipPing environment configuration
# Copy this file to ".env" and fill in your real values.
# =============================================================

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Default Telegram chat id (your numerical id from @userinfobot, or @channel_handle).
# Used when an alert does not specify its own chat id. (required)
TELEGRAM_CHAT_ID=

# Twelve Data API key for forex/gold prices: https://twelvedata.com (required for forex/gold)
# Free tier: 800 requests/day, 8 requests/min.
TWELVE_DATA_API_KEY=

# HTTP server port (default 8080)
PORT=8080

# Price-poll interval in milliseconds.
# Default 120000 (2 min) keeps Twelve Data well under the 800/day free quota.
POLL_INTERVAL_MS=120000
