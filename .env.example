# =============================================================
# pipPing environment configuration
# Copy this file to ".env" and fill in your real values.
# =============================================================

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Default Telegram chat id (your numerical id from @userinfobot, or @channel_handle).
# Used when an alert does not specify its own chat id. (required)
TELEGRAM_CHAT_ID=

# Twelve Data API key for forex / gold prices: https://twelvedata.com
# WebSocket free tier: 8 simultaneous symbol subscriptions, no credit cost.
TWELVE_DATA_API_KEY=

# HTTP server port (default 8080)
PORT=8080

# -----------------------------------------------------------------
# Crypto polling interval (Binance is free, polled fast).
# 60s gives you alerts within a minute of the price crossing.
# Forex/gold no longer use polling — they're streamed via the
# Twelve Data WebSocket and fire within a second.
# -----------------------------------------------------------------
POLL_INTERVAL_CRYPTO_MS=60000
